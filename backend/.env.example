DATABASE_URL=postgresql+asyncpg://cryptoalert:cryptoalert@localhost:5433/cryptoalert
RABBITMQ_URL=amqps://user:pass@host.cloudamqp.com/vhost
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=alerts@yourdomain.com
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
POLL_INTERVAL_SECONDS=30
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Optional. Leave empty to use the keyless public API. Set a free Demo key to raise the
# rate limit and avoid shared-cloud-IP throttling on Render. Keep COINGECKO_BASE_URL as-is
# for a Demo key; only Pro keys use https://pro-api.coingecko.com/api/v3
COINGECKO_API_KEY=
